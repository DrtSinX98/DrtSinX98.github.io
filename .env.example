# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp
# Database name used for every collection
MONGODB_DB=vortex

# Secret used to sign the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Bootstrap password for /admin. After the first `npm run seed` the hash lives in
# MongoDB and can be changed from Admin -> Settings; this stays as the fallback.
ADMIN_PASSWORD=change-me

# https://api.imgbb.com/ — used for every image uploaded from the admin panel
IMGBB_API_KEY=change-me
